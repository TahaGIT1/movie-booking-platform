NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cineverse
JWT_SECRET=supersecretjwtkey123456789
JWT_REFRESH_SECRET=supersecretrefreshkey123456789

# ====================================================================
# TMDB API Configuration (Movie Discovery, Trending, Trailers & Metadata)
# ====================================================================
# Obtain your free API Key and Read Access Token from: https://www.themoviedb.org/settings/api
# 1. TMDB_API_KEY: 32-character hexadecimal key (v3 auth)
TMDB_API_KEY=your_tmdb_api_key_here
# 2. TMDB_READ_ACCESS_TOKEN: JWT Bearer token (v4 auth)
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# ====================================================================
# Ticketmaster Discovery API Configuration (Live Sports, Plays, Music)
# ====================================================================
# Obtain your Consumer Key and Consumer Secret from: https://developer.ticketmaster.com/apps/
# 1. TICKETMASTER_API_KEY: 32-character Consumer Key
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key_here
# 2. TICKETMASTER_CONSUMER_SECRET: Consumer Secret (required for partner/inventory integrations)
TICKETMASTER_CONSUMER_SECRET=your_ticketmaster_consumer_secret_here


