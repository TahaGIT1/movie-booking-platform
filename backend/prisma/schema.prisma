// schema.prisma (MongoDB via Prisma; ids are UUID strings stored in _id)
// Optional unique fields (gstNumber, mobileNumber, gatewayTransactionId) are enforced by
// partial unique indexes in scripts/ensure-mongo-indexes.js: a plain MongoDB unique index
// treats every null as a duplicate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  THEATRE_MANAGER
  THEATRE_STAFF
  SUPER_ADMIN
}

enum TheatreStatus {
  PENDING
  DOCS_VERIFIED
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
}

enum VisualFormat {
  TWO_D    @map("2D")
  THREE_D  @map("3D")
  IMAX
  FOUR_DX  @map("4DX")
  SCREEN_X
}

enum SeatTier {
  NORMAL
  PREMIUM
  RECLINER
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

enum BookingStatus {
  INITIATED
  PROCESSING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketScanStatus {
  UNUSED
  USED
  INVALIDATED
}

model Theatre {
  id              String        @id @default(uuid()) @map("_id")
  name            String       
  legalEntityName String?       @map("legal_entity_name")
  gstNumber       String?       @map("gst_number")
  contactPhone    String?       @map("contact_phone")
  contactEmail    String?       @map("contact_email")
  addressLine     String        @map("address_line")
  city            String       
  state           String       
  postalCode      String?       @map("postal_code")
  latitude        Float?       
  longitude       Float?       
  amenities       Json          @default("[]")
  status          TheatreStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  users           User[]
  documents       TheatreDocument[]
  screens         Screen[]
  shows           Show[]
  concessionItems ConcessionItem[]
  coupons         Coupon[]

  @@index([city, status])
  @@map("theatres")
}

model User {
  id                  String    @id @default(uuid()) @map("_id")
  theatreId           String?   @map("theatre_id")
  role                UserRole  @default(CUSTOMER)
  fullName            String    @map("full_name")
  email               String    @unique
  mobileNumber        String?   @map("mobile_number")
  passwordHash        String?   @map("password_hash")
  profilePhotoUrl     String?   @map("profile_photo_url")
  preferences         Json      @default("{}")
  isBlocked           Boolean   @default(false) @map("is_blocked")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  theatre           Theatre?          @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  refreshTokens     RefreshToken[]
  reviewedDocuments TheatreDocument[] @relation("ReviewedDocuments")
  bookings          Booking[]
  scannedBookings   Booking[]         @relation("ScannedBookings")
  reviews           Review[]
  watchlists        Watchlist[]
  notifications     Notification[]
  auditLogs         AuditLog[]        @relation("AuditLogs")

  @@map("users")
}

model RolePermission {
  id         String   @id @default(uuid()) @map("_id")
  role       UserRole
  permission String  
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([role, permission])
  @@map("roles_permissions")
}

model RefreshToken {
  id          String    @id @default(uuid()) @map("_id")
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  deviceLabel String?   @map("device_label")
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address") // changed from @db.Inet since Prisma treats it as string by default without preview features
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model TheatreDocument {
  id                 String    @id @default(uuid()) @map("_id")
  theatreId          String    @map("theatre_id")
  documentType       String    @map("document_type")
  fileUrl            String    @map("file_url")
  verificationStatus String    @default("PENDING") @map("verification_status")
  rejectionReason    String?   @map("rejection_reason")
  reviewedBy         String?   @map("reviewed_by")
  reviewedAt         DateTime? @map("reviewed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  theatre  Theatre @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ReviewedDocuments", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("theatre_documents")
}

model Screen {
  id               String         @id @default(uuid()) @map("_id")
  theatreId        String         @map("theatre_id")
  screenNumber     String         @map("screen_number")
  name             String        
  supportedFormats VisualFormat[] @default([TWO_D]) @map("supported_formats")
  soundSystem      String?        @map("sound_system")
  totalCapacity    Int            @map("total_capacity")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  theatre Theatre @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  seats   Seat[]
  shows   Show[]

  @@unique([theatreId, screenNumber])
  @@map("screens")
}

model Seat {
  id           String   @id @default(uuid()) @map("_id")
  screenId     String   @map("screen_id")
  rowLabel     String   @map("row_label")
  seatNumber   Int      @map("seat_number")
  tier         SeatTier @default(NORMAL)
  isAccessible Boolean  @default(false) @map("is_accessible")
  isBroken     Boolean  @default(false) @map("is_broken")
  gridX        Int      @map("grid_x")
  gridY        Int      @map("grid_y")
  createdAt    DateTime @default(now()) @map("created_at")

  screen       Screen           @relation(fields: [screenId], references: [id], onDelete: Cascade)
  showStatuses ShowSeatStatus[]
  bookingSeats BookingSeat[]

  @@unique([screenId, rowLabel, seatNumber])
  @@map("seats")
}

model Movie {
  id                 String    @id @default(uuid()) @map("_id")
  title              String   
  synopsis           String?
  durationMinutes    Int       @map("duration_minutes")
  censorCertificate  String    @map("censor_certificate")
  originalLanguage   String    @map("original_language")
  supportedLanguages String[]  @default([]) @map("supported_languages")
  genres             String[]  @default([])
  castMembers        Json      @default("[]") @map("cast_members")
  director           String?  
  posterUrl          String?   @map("poster_url")
  trailerUrl         String?   @map("trailer_url")
  releaseDate        DateTime? @map("release_date")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  shows      Show[]
  coupons    Coupon[]
  reviews    Review[]
  watchlists Watchlist[]

  @@map("movies")
}

model Show {
  id              String       @id @default(uuid()) @map("_id")
  theatreId       String       @map("theatre_id")
  screenId        String       @map("screen_id")
  movieId         String       @map("movie_id")
  startTime       DateTime     @map("start_time")
  endTime         DateTime     @map("end_time")
  visualFormat    VisualFormat @default(TWO_D) @map("visual_format")
  languageVersion String       @map("language_version")
  baseTierPricing Json         @map("base_tier_pricing")
  isCancelled     Boolean      @default(false) @map("is_cancelled")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")

  theatre      Theatre          @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  screen       Screen           @relation(fields: [screenId], references: [id], onDelete: Restrict)
  movie        Movie            @relation(fields: [movieId], references: [id], onDelete: Restrict)
  seatStatuses ShowSeatStatus[]
  bookings     Booking[]

  @@index([theatreId, startTime, isCancelled])
  @@index([movieId, startTime])
  @@map("shows")
}

model ShowSeatStatus {
  id             String     @id @default(uuid()) @map("_id")
  showId         String     @map("show_id")
  seatId         String     @map("seat_id")
  status         SeatStatus @default(AVAILABLE)
  lockedByUserId String?    @map("locked_by_user_id")
  lockExpiresAt  DateTime?  @map("lock_expires_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat Seat @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@unique([showId, seatId])
  @@index([showId, status])
  @@map("show_seat_status")
}

model ConcessionItem {
  id           String   @id @default(uuid()) @map("_id")
  theatreId    String   @map("theatre_id")
  name         String  
  category     String? 
  priceCents   Int      @map("price_cents")
  isVegetarian Boolean  @default(true) @map("is_vegetarian")
  imageUrl     String?  @map("image_url")
  isInStock    Boolean  @default(true) @map("is_in_stock")
  createdAt    DateTime @default(now()) @map("created_at")

  theatre  Theatre             @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  bookings BookingConcession[]

  @@map("concession_items")
}

model Coupon {
  id                 String   @id @default(uuid()) @map("_id")
  code               String   @unique
  theatreId          String?  @map("theatre_id")
  movieId            String?  @map("movie_id")
  discountPercentage Float?   @map("discount_percentage")
  flatDiscountAmount Int?     @map("flat_discount_amount")
  minSpendAmount     Int      @default(0) @map("min_spend_amount")
  maxDiscountCap     Int?     @map("max_discount_cap")
  totalUsageLimit    Int      @default(0) @map("total_usage_limit")
  perUserLimit       Int      @default(1) @map("per_user_limit")
  currentRedemptions Int      @default(0) @map("current_redemptions")
  validFrom          DateTime @map("valid_from")
  validUntil         DateTime @map("valid_until")
  createdAt          DateTime @default(now()) @map("created_at")

  theatre  Theatre?  @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  movie    Movie?    @relation(fields: [movieId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@map("coupons")
}

model Booking {
  id                   String           @id @default(uuid()) @map("_id")
  bookingReference     String           @unique @map("booking_reference")
  userId               String           @map("user_id")
  showId               String           @map("show_id")
  couponId             String?          @map("coupon_id")
  subtotalCents        Int              @map("subtotal_cents")
  convenienceFeeCents  Int              @default(0) @map("convenience_fee_cents")
  taxCents             Int              @default(0) @map("tax_cents")
  discountCents        Int              @default(0) @map("discount_cents")
  totalAmountCents     Int              @map("total_amount_cents")
  status               BookingStatus    @default(INITIATED)
  qrPayloadHash        String?          @map("qr_payload_hash")
  qrScanStatus         TicketScanStatus @default(UNUSED) @map("qr_scan_status")
  scannedAt            DateTime?        @map("scanned_at")
  scannedByStaffId     String?          @map("scanned_by_staff_id")
  cancellationFeeCents Int              @default(0) @map("cancellation_fee_cents")
  refundAmountCents    Int              @default(0) @map("refund_amount_cents")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  show        Show                @relation(fields: [showId], references: [id], onDelete: Restrict)
  coupon      Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  scannedBy   User?               @relation("ScannedBookings", fields: [scannedByStaffId], references: [id], onDelete: SetNull)
  seats       BookingSeat[]
  concessions BookingConcession[]
  payments    Payment[]
  refunds     Refund[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([bookingReference, qrScanStatus])
  @@map("bookings")
}

model BookingSeat {
  id                  String @id @default(uuid()) @map("_id")
  bookingId           String @map("booking_id")
  seatId              String @map("seat_id")
  allocatedPriceCents Int    @map("allocated_price_cents")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@unique([bookingId, seatId])
  @@map("booking_seats")
}

model BookingConcession {
  id             String @id @default(uuid()) @map("_id")
  bookingId      String @map("booking_id")
  itemId         String @map("item_id")
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item    ConcessionItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("booking_concessions")
}

model Payment {
  id                   String        @id @default(uuid()) @map("_id")
  bookingId            String        @map("booking_id")
  gatewayName          String        @default("MOCK") @map("gateway_name")
  gatewayTransactionId String?       @map("gateway_transaction_id")
  gatewayOrderId       String?       @map("gateway_order_id")
  amountCents          Int           @map("amount_cents")
  currency             String        @default("INR")
  paymentMethod        String        @map("payment_method")
  status               PaymentStatus @default(INITIATED)
  idempotencyKey       String        @unique @map("idempotency_key")
  gatewayResponse      Json?         @map("gateway_response_payload")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at")

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([bookingId])
  @@map("payments")
}

model Refund {
  id          String   @id @default(uuid()) @map("_id")
  bookingId   String   @map("booking_id")
  paymentId   String?  @map("payment_id")
  amountCents Int      @map("amount_cents")
  status      String   @default("PENDING")
  reason      String?
  providerRef String?  @map("provider_ref")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("refunds")
}

model Review {
  id          String   @id @default(uuid()) @map("_id")
  userId      String   @map("user_id")
  movieId     String   @map("movie_id")
  ratingScore Int      @map("rating_score")
  reviewText  String?  @map("review_text")
  photosUrls  String[] @map("photos_urls")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("reviews")
}

model Watchlist {
  id        String   @id @default(uuid()) @map("_id")
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("watchlist")
}

model Notification {
  id            String   @id @default(uuid()) @map("_id")
  userId        String   @map("user_id")
  type          String  
  title         String  
  body          String?
  relatedEntity String?  @map("related_entity")
  relatedId     String?  @map("related_id")
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid()) @map("_id")
  actorId       String?  @map("actor_id")
  action        String  
  targetEntity  String   @map("target_entity")
  targetId      String?  @map("target_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// Email OTP codes for signup / password reset (previously a raw-SQL-only table).
model EmailOtp {
  id        String   @id @default(uuid()) @map("_id")
  email     String
  code      String
  purpose   String
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, purpose])
  @@map("email_otps")
}
