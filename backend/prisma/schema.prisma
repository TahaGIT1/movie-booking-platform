// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  THEATRE_MANAGER
  THEATRE_STAFF
  SUPER_ADMIN
}

enum TheatreStatus {
  PENDING
  DOCS_VERIFIED
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
}

enum VisualFormat {
  TWO_D    @map("2D")
  THREE_D  @map("3D")
  IMAX
  FOUR_DX  @map("4DX")
  SCREEN_X
}

enum SeatTier {
  NORMAL
  PREMIUM
  RECLINER
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

enum BookingStatus {
  INITIATED
  PROCESSING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketScanStatus {
  UNUSED
  USED
  INVALIDATED
}

model Theatre {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(255)
  legalEntityName String?       @map("legal_entity_name") @db.VarChar(255)
  gstNumber       String?       @unique @map("gst_number") @db.VarChar(32)
  contactPhone    String?       @map("contact_phone") @db.VarChar(20)
  contactEmail    String?       @map("contact_email") @db.VarChar(255)
  addressLine     String        @map("address_line")
  city            String        @db.VarChar(100)
  state           String        @db.VarChar(100)
  postalCode      String?       @map("postal_code") @db.VarChar(16)
  latitude        Decimal?      @db.Decimal(10, 8)
  longitude       Decimal?      @db.Decimal(11, 8)
  amenities       Json          @default("[]")
  status          TheatreStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users           User[]
  documents       TheatreDocument[]
  screens         Screen[]
  shows           Show[]
  concessionItems ConcessionItem[]
  coupons         Coupon[]

  @@index([city, status])
  @@map("theatres")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  theatreId           String?   @map("theatre_id") @db.Uuid
  role                UserRole  @default(CUSTOMER)
  fullName            String    @map("full_name") @db.VarChar(128)
  email               String    @unique @db.VarChar(255)
  mobileNumber        String?   @unique @map("mobile_number") @db.VarChar(20)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  profilePhotoUrl     String?   @map("profile_photo_url")
  preferences         Json      @default("{}")
  isBlocked           Boolean   @default(false) @map("is_blocked")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  theatre           Theatre?          @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  refreshTokens     RefreshToken[]
  reviewedDocuments TheatreDocument[] @relation("ReviewedDocuments")
  bookings          Booking[]
  scannedBookings   Booking[]         @relation("ScannedBookings")
  reviews           Review[]
  watchlists        Watchlist[]
  notifications     Notification[]
  auditLogs         AuditLog[]        @relation("AuditLogs")

  @@map("users")
}

model RolePermission {
  id         BigInt   @id @default(autoincrement())
  role       UserRole
  permission String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([role, permission])
  @@map("roles_permissions")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  deviceLabel String?   @map("device_label") @db.VarChar(128)
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address") // changed from @db.Inet since Prisma treats it as string by default without preview features
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model TheatreDocument {
  id                 String    @id @default(uuid()) @db.Uuid
  theatreId          String    @map("theatre_id") @db.Uuid
  documentType       String    @map("document_type") @db.VarChar(64)
  fileUrl            String    @map("file_url")
  verificationStatus String    @default("PENDING") @map("verification_status") @db.VarChar(32)
  rejectionReason    String?   @map("rejection_reason")
  reviewedBy         String?   @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  theatre  Theatre @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ReviewedDocuments", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("theatre_documents")
}

model Screen {
  id               String         @id @default(uuid()) @db.Uuid
  theatreId        String         @map("theatre_id") @db.Uuid
  screenNumber     String         @map("screen_number") @db.VarChar(16)
  name             String         @db.VarChar(64)
  supportedFormats VisualFormat[] @default([TWO_D]) @map("supported_formats")
  soundSystem      String?        @map("sound_system") @db.VarChar(64)
  totalCapacity    Int            @map("total_capacity")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  theatre Theatre @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  seats   Seat[]
  shows   Show[]

  @@unique([theatreId, screenNumber])
  @@map("screens")
}

model Seat {
  id           String   @id @default(uuid()) @db.Uuid
  screenId     String   @map("screen_id") @db.Uuid
  rowLabel     String   @map("row_label") @db.VarChar(4)
  seatNumber   Int      @map("seat_number")
  tier         SeatTier @default(NORMAL)
  isAccessible Boolean  @default(false) @map("is_accessible")
  isBroken     Boolean  @default(false) @map("is_broken")
  gridX        Int      @map("grid_x")
  gridY        Int      @map("grid_y")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  screen       Screen           @relation(fields: [screenId], references: [id], onDelete: Cascade)
  showStatuses ShowSeatStatus[]
  bookingSeats BookingSeat[]

  @@unique([screenId, rowLabel, seatNumber])
  @@map("seats")
}

model Movie {
  id                 String    @id @default(uuid()) @db.Uuid
  title              String    @db.VarChar(255)
  synopsis           String?
  durationMinutes    Int       @map("duration_minutes")
  censorCertificate  String    @map("censor_certificate") @db.VarChar(8)
  originalLanguage   String    @map("original_language") @db.VarChar(64)
  supportedLanguages String[]  @default([]) @map("supported_languages") @db.VarChar(64)
  genres             String[]  @default([]) @db.VarChar(64)
  castMembers        Json      @default("[]") @map("cast_members")
  director           String?   @db.VarChar(128)
  posterUrl          String?   @map("poster_url")
  trailerUrl         String?   @map("trailer_url")
  releaseDate        DateTime? @map("release_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  shows      Show[]
  coupons    Coupon[]
  reviews    Review[]
  watchlists Watchlist[]

  @@map("movies")
}

model Show {
  id              String       @id @default(uuid()) @db.Uuid
  theatreId       String       @map("theatre_id") @db.Uuid
  screenId        String       @map("screen_id") @db.Uuid
  movieId         String       @map("movie_id") @db.Uuid
  startTime       DateTime     @map("start_time") @db.Timestamptz
  endTime         DateTime     @map("end_time") @db.Timestamptz
  visualFormat    VisualFormat @default(TWO_D) @map("visual_format")
  languageVersion String       @map("language_version") @db.VarChar(64)
  baseTierPricing Json         @map("base_tier_pricing")
  isCancelled     Boolean      @default(false) @map("is_cancelled")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  theatre      Theatre          @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  screen       Screen           @relation(fields: [screenId], references: [id], onDelete: Restrict)
  movie        Movie            @relation(fields: [movieId], references: [id], onDelete: Restrict)
  seatStatuses ShowSeatStatus[]
  bookings     Booking[]

  @@index([theatreId, startTime, isCancelled])
  @@index([movieId, startTime])
  @@map("shows")
}

model ShowSeatStatus {
  id             String     @id @default(uuid()) @db.Uuid
  showId         String     @map("show_id") @db.Uuid
  seatId         String     @map("seat_id") @db.Uuid
  status         SeatStatus @default(AVAILABLE)
  lockedByUserId String?    @map("locked_by_user_id") @db.Uuid
  lockExpiresAt  DateTime?  @map("lock_expires_at") @db.Timestamptz
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat Seat @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@unique([showId, seatId])
  @@index([showId, status])
  @@map("show_seat_status")
}

model ConcessionItem {
  id           String   @id @default(uuid()) @db.Uuid
  theatreId    String   @map("theatre_id") @db.Uuid
  name         String   @db.VarChar(128)
  category     String?  @db.VarChar(64)
  priceCents   Int      @map("price_cents")
  isVegetarian Boolean  @default(true) @map("is_vegetarian")
  imageUrl     String?  @map("image_url")
  isInStock    Boolean  @default(true) @map("is_in_stock")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  theatre  Theatre             @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  bookings BookingConcession[]

  @@map("concession_items")
}

model Coupon {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique @db.VarChar(32)
  theatreId          String?  @map("theatre_id") @db.Uuid
  movieId            String?  @map("movie_id") @db.Uuid
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  flatDiscountAmount Int?     @map("flat_discount_amount")
  minSpendAmount     Int      @default(0) @map("min_spend_amount")
  maxDiscountCap     Int?     @map("max_discount_cap")
  totalUsageLimit    Int      @default(0) @map("total_usage_limit")
  perUserLimit       Int      @default(1) @map("per_user_limit")
  currentRedemptions Int      @default(0) @map("current_redemptions")
  validFrom          DateTime @map("valid_from") @db.Timestamptz
  validUntil         DateTime @map("valid_until") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  theatre  Theatre?  @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  movie    Movie?    @relation(fields: [movieId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@map("coupons")
}

model Booking {
  id                   String           @id @default(uuid()) @db.Uuid
  bookingReference     String           @unique @map("booking_reference") @db.VarChar(20)
  userId               String           @map("user_id") @db.Uuid
  showId               String           @map("show_id") @db.Uuid
  couponId             String?          @map("coupon_id") @db.Uuid
  subtotalCents        Int              @map("subtotal_cents")
  convenienceFeeCents  Int              @default(0) @map("convenience_fee_cents")
  taxCents             Int              @default(0) @map("tax_cents")
  discountCents        Int              @default(0) @map("discount_cents")
  totalAmountCents     Int              @map("total_amount_cents")
  status               BookingStatus    @default(INITIATED)
  qrPayloadHash        String?          @map("qr_payload_hash")
  qrScanStatus         TicketScanStatus @default(UNUSED) @map("qr_scan_status")
  scannedAt            DateTime?        @map("scanned_at") @db.Timestamptz
  scannedByStaffId     String?          @map("scanned_by_staff_id") @db.Uuid
  cancellationFeeCents Int              @default(0) @map("cancellation_fee_cents")
  refundAmountCents    Int              @default(0) @map("refund_amount_cents")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  show        Show                @relation(fields: [showId], references: [id], onDelete: Restrict)
  coupon      Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  scannedBy   User?               @relation("ScannedBookings", fields: [scannedByStaffId], references: [id], onDelete: SetNull)
  seats       BookingSeat[]
  concessions BookingConcession[]
  payments    Payment[]
  refunds     Refund[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([bookingReference, qrScanStatus])
  @@map("bookings")
}

model BookingSeat {
  id                  String @id @default(uuid()) @db.Uuid
  bookingId           String @map("booking_id") @db.Uuid
  seatId              String @map("seat_id") @db.Uuid
  allocatedPriceCents Int    @map("allocated_price_cents")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@unique([bookingId, seatId])
  @@map("booking_seats")
}

model BookingConcession {
  id             String @id @default(uuid()) @db.Uuid
  bookingId      String @map("booking_id") @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item    ConcessionItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("booking_concessions")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  bookingId            String        @map("booking_id") @db.Uuid
  gatewayName          String        @default("MOCK") @map("gateway_name") @db.VarChar(64)
  gatewayTransactionId String?       @unique @map("gateway_transaction_id") @db.VarChar(128)
  gatewayOrderId       String?       @map("gateway_order_id") @db.VarChar(128)
  amountCents          Int           @map("amount_cents")
  currency             String        @default("INR") @db.VarChar(3)
  paymentMethod        String        @map("payment_method") @db.VarChar(32)
  status               PaymentStatus @default(INITIATED)
  idempotencyKey       String        @unique @map("idempotency_key") @db.Uuid
  gatewayResponse      Json?         @map("gateway_response_payload")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([bookingId])
  @@map("payments")
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  paymentId   String?  @map("payment_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  status      String   @default("PENDING") @db.VarChar(32)
  reason      String?
  providerRef String?  @map("provider_ref") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("refunds")
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  movieId     String   @map("movie_id") @db.Uuid
  ratingScore Int      @map("rating_score") @db.SmallInt
  reviewText  String?  @map("review_text")
  photosUrls  String[] @map("photos_urls")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("reviews")
}

model Watchlist {
  userId    String   @map("user_id") @db.Uuid
  movieId   String   @map("movie_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@map("watchlist")
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  type          String   @db.VarChar(64)
  title         String   @db.VarChar(255)
  body          String?
  relatedEntity String?  @map("related_entity") @db.VarChar(64)
  relatedId     String?  @map("related_id") @db.Uuid
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(64)
  targetEntity  String   @map("target_entity") @db.VarChar(64)
  targetId      String?  @map("target_id") @db.Uuid
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("AuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
